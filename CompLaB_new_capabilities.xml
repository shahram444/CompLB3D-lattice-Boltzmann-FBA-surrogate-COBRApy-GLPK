<?xml version="1.0" ?>
<!-- ============================================================================
     CompLaB_new_capabilities.xml
     THE FOUR BLOCKS THAT ARE NOW HANDLED NATIVELY IN C++
     ============================================================================

     WHAT THIS FILE IS

     A complete, RUNNABLE input file that turns on every new capability at once,
     with every tag it accepts written out and explained. Copy it to CompLaB.xml,
     put its geometry in input/, build with -DENABLE_GLPK=ON, and run it. It is
     the same configuration as examples/16_complete_pipeline, with the optional
     tags spelled out instead of left at their defaults.

     Anything COMMENTED OUT below is commented for a stated reason, not because
     it is untested. The reason is given at each one.

     ============================================================================
     WHAT THESE BLOCKS REPLACE

       before                                     now
       ========================================== ===========================
       download a model, run extractMM.py         <model_source>
       count reaction columns by hand             <exchange_reaction_names>
       run geometry.py to build a pore space      <generate> inside <domain>
       generateTrainingData.py -> trainSurrogate  <surrogate><train_if_missing>
         -> exportSurrogateHeader -> rebuild
       load the VTI files in Python afterwards    <diagnostics>

     Every one of them is OPTIONAL and absent by default. An input file written
     before they existed takes exactly the path it always took: the code looks
     for the block, does not find it, and carries on.

     ============================================================================
     WHERE EACH BLOCK IS READ, IF YOU WANT TO CHECK THE CODE

       <model_source> family      src/complab3d_fetch.hh      ensureModel()
       <exchange_reaction_names>  src/complab3d_sbml.hh       resolveExchangeNames()
       <generate>/<import_raw>    src/complab3d_geometry.hh   generate(), importRaw()
       <surrogate>                src/complab3d_surrogate.hh  train(), load(), save()
       <diagnostics>              src/complab3d_diagnostics.hh Diagnostics::record()
       all of the parsing         src/complab3d_integration.hh readConfig()

     ============================================================================
     CompLaB is free software under the GNU Affero General Public License v3 or
     later.  Meile Lab, University of Georgia.  shahram.asgari@uga.edu
     ============================================================================ -->
<parameters>

    <path>
        <src_path>src</src_path>
        <input_path>input</input_path>
        <output_path>output</output_path>
    </path>

    <simulation_mode>
        <biotic_mode>true</biotic_mode>
        <enable_kinetics>false</enable_kinetics>
        <enable_abiotic_kinetics>false</enable_abiotic_kinetics>

        <!-- THE FIRST OF THE TWO GATES.
             This one says the solver is compiled in and available in this run.
             The second is <reaction_type> inside each <microbeN>, further down,
             which says that this organism uses it. Asking in one place and not
             the other stops the run with a message naming what is missing.

             Here: no organism runs FBA at every voxel, but the surrogate is
             TRAINED from a linear program at start-up, so the executable still
             has to be built with -DENABLE_GLPK=ON. -->
        <enable_fba_glpk>false</enable_fba_glpk>
        <enable_fba_cobrapy>false</enable_fba_cobrapy>
        <enable_surrogate>true</enable_surrogate>

        <enable_validation_diagnostics>false</enable_validation_diagnostics>
    </simulation_mode>


    <!-- ========================================================================
         [NEW 1 of 4]  WHERE THE METABOLIC MODEL COMES FROM
         ========================================================================

         Replaces: find the model on BiGG, download it, run extractMM.py.

         SEARCH ORDER, fixed, and reported in the log:

           1. already unpacked in <model_cache>            -> used as is
           2. bundled as <model_bundle>/<id>.xml.gz        -> unpacked into the cache
           3. downloaded                                   -> only if <allow_download>

         Three models ship bundled: e_coli_core, iJO1366, STM_v1_0.

         Whichever branch runs, the file is checked against models/manifest.txt,
         which records each model's species and reaction counts, its parsed
         metabolite and reaction counts, its objective reaction, a hash and the
         source URL. A mismatch does NOT stop the run; it prints what it expected
         against what it found, so a model revised upstream shows up in the log
         instead of silently changing your results.

         UNDER MPI only rank 0 unpacks or downloads. The others wait at a barrier
         and then find the file already there.
         ======================================================================== -->

    <!-- provider:id.  Two providers:
           bigg:<id>     http://bigg.ucsd.edu/static/models/<id>.xml
           url:<http…>   anything else, by explicit URL
         Absent means every FBA or surrogate microbe supplies its own
         <model_filename> instead. -->
    <model_source>bigg:e_coli_core</model_source>

    <!-- Where the gzipped bundled models live, relative to the working
         directory.  Default: models -->
    <model_bundle>models</model_bundle>

    <!-- Where the unpacked .xml is put, and looked for first.
         Default: input -->
    <model_cache>input</model_cache>

    <!-- Permit fetching over the network when the model is neither cached nor
         bundled.  Default: false, and it should stay false on a cluster: a
         compute node usually has no route to the internet, and a run that
         silently depends on one is a run that will fail at 3 a.m.
         This is exactly why the models are bundled. -->
    <allow_download>false</allow_download>


    <!-- ========================================================================
         [NEW 2 of 4]  THE SURROGATE, FITTED BY THE RUN ITSELF
         ========================================================================

         Replaces: generateTrainingData.py, then trainSurrogate.py or .m, then
         exportSurrogateHeader.m, then pasting the weights into surrogateModel.hh,
         then a full rebuild.

         The change that makes this possible is that the weights now live in a
         FILE the solver reads at run time rather than in a header it was compiled
         with. That removes the rebuild, and it lets the TRAINING RANGE travel
         with the weights, so the solver can refuse to extrapolate.

         WHAT HAPPENS AT START-UP

           <weights_file> exists      -> load it, print its valid range, done.
           absent, train_if_missing   -> build a linear program, sweep it, fit,
                                         verify on fresh points, write the file.
           absent, and not allowed    -> stop, and say which of the two to set.

         WHERE THE LINEAR PROGRAM COMES FROM

           If this run already has a microbe with <reaction_type>glpk, ITS
           persistent problem is swept == the same object the simulation would
           have solved, with the same <constraint_indices> overrides. The network
           is then a fit to exactly the thing it replaces.

           If it does not, which is the usual case for a surrogate-only run, a
           temporary problem is built from the surrogate microbe's own model and
           released as soon as training finishes. The log says which happened.

         TRAINING IS ON RANK 0 ONLY. Every rank fitting its own network from its
         own random start would give a different growth rate in each subdomain.
         Rank 0 trains, writes the file, everyone barriers, the others read it.
         ======================================================================== -->
    <surrogate>

        <!-- The whole block is ignored when this is false.  Default: false -->
        <enabled>true</enabled>

        <!-- The network file.  Plain text on purpose: a trained network is a
             scientific result and should be readable, diffable and quotable in a
             paper without a tool.  Required when <enabled> is true. -->
        <weights_file>output/ecoli.srg</weights_file>

        <!-- Fit one now if the file is not there, instead of stopping.
             Default: false.  Needs a flux balance solver, so -DENABLE_GLPK=ON. -->
        <train_if_missing>true</train_if_missing>

        <!-- Which microbe this network is for.  -1, the default, means every
             microbe whose <reaction_type> is a surrogate type == which is the
             common case of one organism, where asking the user for an index is
             just an opportunity to get one wrong. -->
        <microbe>-1</microbe>

        <train>
            <!-- Points in the sweep.  Default: 2000.  Each one is a linear
                 program, so this is the cost.  300 is enough for two smooth
                 inputs; a genome-scale model with a kink wants more. -->
            <samples>300</samples>

            <!-- Hidden layer sizes.  Default: 10 10 10 10.
                 Bigger is not better here: the function being fitted is smooth
                 and the sample count is the binding constraint. -->
            <layers>8</layers>

            <!-- Independent fits from different random starts; the best is kept.
                 Default: 5. -->
            <restarts>2</restarts>

            <!-- Adam iterations per restart, with early stopping on a held-out
                 split.  Default: 4000. -->
            <epochs>400</epochs>

            <!-- Fresh points, drawn independently and RE-SOLVED BY THE LINEAR
                 PROGRAM, that the network never saw.  Default: 512.
                 This is the step that makes the result trustworthy: the fit
                 statistics are computed on a held-out split of the same sweep,
                 which cannot catch a network that has learned the sampling
                 rather than the function. -->
            <verify_points>64</verify_points>

            <!-- Fit log10 of the growth rate instead of the growth rate.
                 Default: false.  Worth trying when growth spans decades. -->
            <log_output>false</log_output>

            <!-- The fit is reproducible from this seed on every compiler and
                 every machine.  Default: 1.
                 (The RNG is written out by hand rather than using <random>,
                 because std::mt19937 is portable but its DISTRIBUTIONS are not.) -->
            <seed>20260814</seed>

            <!-- ============================================================
                 THE INPUT RANGES.  <input0> through <input7>.

                 Each line is:   <substrate name>  <low>  <high>  [log]

                 The name must be one of <name_of_substrates>. "log" samples
                 logarithmically, which you want whenever the range spans more
                 than about one order of magnitude: pore concentrations
                 routinely span four, and a linear grid puts nearly all its
                 points in the top decade, so the fit is worst exactly where
                 the biology is most sensitive.

                 KEEP TO 1 TO 3 INPUTS. Past that the samples needed grow
                 faster than the fit improves, and the run stops with a message
                 saying so.

                 THE UPPER END SHOULD BE <fba_maximum_uptake_flux>. CompLaB's
                 uptake bound is Michaelis-Menten, V = Vmax * C / (Kc + C), so
                 no voxel can ever request more than Vmax. Anything above it is
                 sweep points spent on states the simulation cannot reach.

                 THE RANGE IS NOT ADVICE. It is written into the weights file
                 and enforced: at run time every evaluation is CLAMPED to this
                 box and COUNTED, and the end of the run reports how often. Above
                 5% it says, in as many words, that the results should not be
                 used until the ranges are widened and the network refitted.
                 ============================================================ -->
            <input0>glucose 0.1 10.0</input0>
            <input1>o2      0.1 20.0</input1>

            <!-- A logarithmic third input would read:
            <input2>Fe3 1e-5 0.5 log</input2>
                 -->
        </train>
    </surrogate>


    <!-- ========================================================================
         [NEW 3 of 4]  THE RUN'S OWN SCALAR RECORD
         ========================================================================

         Replaces: loading the VTI volumes into Python afterwards to find out
         whether anything was conserved.

         Until this block existed CompLB3D wrote VTI volumes and nothing else, so
         every scalar question == did mass balance, how did porosity change, when
         did a concentration first go negative == was a post-processing job.

         WHAT summary.csv CONTAINS

           iteration, porosity, open_voxels, then for every substrate its total,
           mean, minimum and maximum.

         Totals and means are over OPEN voxels only (pore plus biofilm) and over
         the PHYSICAL domain x = 1 .. nx-2, excluding the two ghost columns. Both
         choices matter: including the solid would make the mean fall as biofilm
         grew for no chemical reason, and including the ghost columns would count
         the inlet and outlet slices twice, so a conserved total would jump
         whenever the inlet concentration changed.

         Only rank 0 writes the file. The numbers are Palabos reductions and are
         already global.
         ======================================================================== -->
    <diagnostics>

        <!-- The whole block is ignored when this is false.  Default: false -->
        <enabled>true</enabled>

        <!-- Written inside <output_path> unless this is an absolute path.
             Default: summary.csv -->
        <summary_csv>summary.csv</summary_csv>

        <!-- Steps between rows.  Default: 0, which follows the VTI interval.
             A scalar row is cheap; there is rarely a reason to want fewer of
             them than there are volumes. -->
        <interval>100</interval>

        <!-- Relative drift above which a conserved sum is reported as failed.
             Default: 1e-6.

             The drift is normalised by the LARGER of the first and current
             values, not by the first alone. Dividing by the baseline breaks
             whenever a run starts from an empty domain: the baseline is 0 and
             the first non-zero total reports a drift of 1e+302, which tells
             nobody anything. With max(|first|, |now|) the number is always
             between 0 and 1 and reads as the fraction that appeared or
             disappeared. -->
        <tolerance>1e-6</tolerance>

        <!-- ================================================================
             CONSERVED SUMS.  <conserve>, then <conserve1> .. <conserve31>.

             Each names a sum of substrates, "+" separated, that the reaction
             network cannot create or destroy. One mole of Fe2+ removed must
             appear as one mole of FeS.

             WHAT TO CONSERVE, AND WHAT NOT TO.  A substrate held at a fixed
             concentration on an inlet is being supplied from OUTSIDE. Its total
             is not conserved and never will be, and naming it here produces a
             failure that means nothing. Conserve a CLOSED sum instead: every
             species carrying one element, which is a conserved moiety of the
             reaction network.

             A check naming a substrate that does not exist is reported as
             SKIPPED, never as PASS. A skipped check that looks like a pass is
             how a mass-balance guarantee quietly becomes worthless.

             This run has no closed sum to check == glucose and oxygen both enter
             at an inlet == so no <conserve> line is set. The CSV is still
             written. Examples for a run that does have one:

             <conserve>Fe2+FeS</conserve>
             <conserve1>HS+FeS</conserve1>
             ================================================================ -->
    </diagnostics>


    <LB_numerics>
        <domain>
            <nx>24</nx>
            <ny>24</ny>
            <nz>6</nz>
            <dx>10</dx>
            <unit>um</unit>
            <characteristic_length>24</characteristic_length>

            <!-- The geometry file, read unless one of the two blocks below is
                 set.  It must be exactly nx * ny * nz integers, one per line,
                 x fastest then y then z, where nx is the number written above.
                 The solver adds two ghost columns of its own and duplicates the
                 first and last slice into them, so a file two slices wider is
                 not an error == it is silently truncated. -->
            <filename>geometry.dat</filename>

            <material_numbers>
                <pore>2</pore>
                <solid>0</solid>
                <bounce_back>1</bounce_back>
                <microbe0>3</microbe0>
            </material_numbers>

            <!-- ============================================================
                 [NEW 4 of 4]  GENERATING OR IMPORTING THE PORE SPACE

                 Replaces: running tools/geometry.py before the simulation.

                 COMMENTED OUT HERE, AND HERE IS THE REASON: the generator
                 writes pore, solid and wall ONLY. It cannot seed the microbe
                 material numbers this run needs (material 3 above), so this
                 case ships a seeded geometry file. Use generation on a case
                 with no attached biomass, or with a planktonic organism.

                 Everything below is tested and works; uncomment it in a case
                 that does not need seeding and <filename> is then ignored.

                 WHAT IT DOES BESIDES BUILDING THE VOLUME

                 The pore space is inspected before the flow solver is built and
                 the report is printed: voxel counts per material, porosity,
                 whether it percolates along x, and how much pore space is
                 isolated. A domain that does NOT percolate STOPS THE RUN == a
                 pressure drop across a sealed medium has no solution and the
                 flow solver would spend its whole iteration budget failing to
                 converge to one.

                 The volume is also written to <write_geometry> inside the input
                 directory before the run starts, so the run is reproducible
                 from its own output even if the seed, the code or this file
                 later change.

            <generate>spheres</generate>
                 One of:  channel   walls only, nothing in the middle
                          spheres   a random sphere pack
                          cylinders the same, through the full z depth
                          random    correlated random field, thresholded
                          fracture  a single rough-walled fracture
                          layered   alternating permeable and solid layers
                 Default kind if <generate> is present but empty: channel

            <porosity>0.55</porosity>
                 Target open fraction, for spheres, cylinders and random.
                 Default: 0.4

            <grain_radius>3.0</grain_radius>
                 Voxels, for spheres and cylinders.  Default: 6

            <grain_count>20</grain_count>
                 Fix the NUMBER of grains instead of the porosity.
                 Default: 20, used only when <porosity> is absent.

            <aperture>6</aperture>
                 Voxels, for fracture.  Default: 6

            <roughness>2</roughness>
                 Fracture wall roughness.  Default: 2

            <layers>4</layers>
                 For layered.  Default: 4

            <seed>12345</seed>
                 The generator is deterministic given this.  Default: 1

            <walls>y</walls>
                 Axes to wall off with bounce-back, e.g. y or yz.  Default: y
                 Walls go on y, not x, because flow is driven along x by
                 <delta_P> and the x faces must stay open for the pressure
                 boundary to mean anything.

            <write_geometry>generated.dat</write_geometry>
                 Where to record what was generated, inside <input_path>.
                 Default: generated_geometry.dat

                 ============================================================
                 IMPORTING A BINARY VOLUME INSTEAD.  Mutually exclusive with
                 <generate>; setting both stops the run.

            <import_raw>rock.raw</import_raw>
                 A flat binary volume in <input_path>, nx*ny*nz elements.

            <raw_dtype>uint8</raw_dtype>
                 uint8, int8, uint16, int16, uint32, int32, float32, float64.
                 Default: uint8

            <threshold>128</threshold>
                 At or above this is one phase, below is the other.
                 Default: 128

            <invert>false</invert>
                 Swap which side of the threshold counts as pore.
                 Default: false

                 For a TIFF or PNG stack, tools/geometry.py still reads those
                 and writes either a .raw for this path or a .dat directly.
                 That is a thing C++ cannot do without an image library, and it
                 is why the Python tools are still shipped.
                 ============================================================ -->
        </domain>

        <delta_P>1e-6</delta_P>
        <Peclet>0</Peclet>
        <tau>0.8</tau>
        <track_performance>false</track_performance>

        <iteration>
            <ns_max_iT1>20000</ns_max_iT1>
            <ns_max_iT2>2000</ns_max_iT2>
            <ns_converge_iT1>1e-6</ns_converge_iT1>
            <ns_converge_iT2>1e-4</ns_converge_iT2>
            <ns_update_interval>10</ns_update_interval>
            <ade_update_interval>1</ade_update_interval>
            <ade_max_iT>400</ade_max_iT>
            <ade_converge_iT>1e-8</ade_converge_iT>
        </iteration>
    </LB_numerics>


    <chemistry>
        <number_of_substrates>3</number_of_substrates>
        <fix_concentration>no no no</fix_concentration>
        <fix_lower_bounds>no no no</fix_lower_bounds>

        <substrate0>
            <name_of_substrates>glucose</name_of_substrates>
            <initial_concentration>1.0</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <left_boundary_condition>1.</left_boundary_condition>
            <right_boundary_type>Dirichlet</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate0>

        <substrate1>
            <name_of_substrates>o2</name_of_substrates>
            <initial_concentration>1.0</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <left_boundary_condition>1.</left_boundary_condition>
            <right_boundary_type>Dirichlet</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate1>

        <substrate2>
            <name_of_substrates>acetate</name_of_substrates>
            <initial_concentration>0.</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>5e-10</in_pore>
                <in_biofilm>5e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Neumann</left_boundary_type>
            <left_boundary_condition>0.</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </substrate2>
    </chemistry>


    <microbiology>
        <number_of_microbes>1</number_of_microbes>

        <microbe0>
            <name_of_microbes>Ecoli</name_of_microbes>
            <solver_type>FD</solver_type>

            <!-- THE SECOND GATE.  One of:
                   none  kinetics  glpk  surrogate  cobrapy
                   glpk_and_kinetics  surrogate_and_kinetics  cobrapy_and_kinetics
                 The numeric spellings 0 to 7 also work, in that order.

                 The combined forms run BOTH paths and add the rates.

                 With surrogate, the network used is the one <weights_file>
                 above names == NOT the weights compiled into surrogateModel.hh.
                 Those are still there and are still used when no <surrogate>
                 block is present, so nothing that worked before changes. -->
            <reaction_type>surrogate</reaction_type>

            <initial_densities>1.0</initial_densities>
            <decay_coefficient>0.01</decay_coefficient>
            <viscosity_ratio_in_biofilm>0</viscosity_ratio_in_biofilm>
            <biomass_diffusion_coefficients>
                <in_pore>3e-13</in_pore>
                <in_biofilm>3e-13</in_biofilm>
            </biomass_diffusion_coefficients>
            <half_saturation_constants>0.05 0.05 0</half_saturation_constants>

            <!-- ============================================================
                 [NEW]  NAMING THE EXCHANGE REACTIONS INSTEAD OF NUMBERING THEM

                 One reaction name per substrate, in <name_of_substrates> order.
                 Use "none" (or "-1") for a substrate this organism does not
                 exchange.

                 WHY THIS AND NOT <exchange_reaction_indices>:

                   An INDEX that points at the wrong reaction is undetectable.
                   The linear program is still well posed, the run proceeds, and
                   the answer is wrong in every voxel.

                   A NAME that does not resolve stops the run at start-up, names
                   the substrate, and lists the boundary reactions whose names
                   are close.

                 Try it: change EX_o2_e to EX_oxygen_e and run.

                 NAMES NEED AN SBML MODEL. The matrix format extractMM.py writes
                 does not carry reaction names, so names with a matrix file are a
                 hard error rather than a silent fallback.

                 If BOTH tags are given the names win, and a note says so.

                 THERE IS NO <model_filename> HERE. <model_source> at the top of
                 this file supplied it. A microbe that names its own file keeps
                 it, so a two-organism run can mix a bundled model with a local
                 one.
                 ============================================================ -->
            <exchange_reaction_names>EX_glc__D_e EX_o2_e EX_ac_e</exchange_reaction_names>

            <!-- Michaelis-Menten Vmax, mmol/gDW/h, one per substrate. This is
                 the upper end of each <inputN> range above, because no voxel can
                 request more than Vmax. Raise one without retraining and the run
                 leaves the training box; it will say so, and say how often. -->
            <fba_maximum_uptake_flux>10. 20. 0.</fba_maximum_uptake_flux>

            <!-- Hard floor and ceiling on each exchange flux. Exchange reactions
                 are written "metabolite ->", so consuming is NEGATIVE. -->
            <substrate_lower_bounds>-10. -20. 0.</substrate_lower_bounds>
            <substrate_upper_bounds>1000. 1000. 1000.</substrate_upper_bounds>

            <objective_direction>maximize</objective_direction>
            <biomass_molar_mass>24.6</biomass_molar_mass>

            <left_boundary_type>Neumann</left_boundary_type>
            <left_boundary_condition>0.</left_boundary_condition>
            <right_boundary_type>Neumann</right_boundary_type>
            <right_boundary_condition>0.</right_boundary_condition>
        </microbe0>
    </microbiology>


    <equilibrium>
        <enabled>false</enabled>
    </equilibrium>


    <IO>
        <read_NS_file>false</read_NS_file>
        <read_ADE_file>false</read_ADE_file>
        <ns_filename>nsLattice</ns_filename>
        <mask_filename>maskLattice</mask_filename>
        <subs_filename>subsLattice</subs_filename>
        <bio_filename>bioLattice</bio_filename>
        <save_VTK_interval>200</save_VTK_interval>
        <save_CHK_interval>0</save_CHK_interval>
        <debug_updRxn>0</debug_updRxn>
    </IO>

</parameters>
